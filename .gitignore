# Eval harness lives in its own repository, cloned into ./evals/ for local
# development (see CLAUDE.md / README.md). It is not part of the published
# plugin, so the whole root-level directory is ignored here. The leading
# slash anchors the pattern to the repo root, so it does NOT also match
# tests/evals/ (the tracked scenario YAMLs).
/evals/

# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Local install backups — created by sub-agent when swapping
# superpowers@claude-plugins-official -> superpowers-safe in the user's
# local Claude Code config. These are for one-shot rollback and should
# not be committed.
.install-backups/
.in_use/
