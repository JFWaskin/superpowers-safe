{
  "name": "@jfwaskin/superpowers-safe-deepseek-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Cordis plugin that registers the superpowers-safe skills into the DeepSeek Harness `ctx.skills` registry. Reuses the existing superpowers/skills/*/SKILL.md files; does not duplicate skill content. See ../README.md for what this bridge covers and what it does not.",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/index": "./src/index.ts"
  },
  "files": [
    "lib/",
    "src/",
    "README.md",
    "cordis.yml",
    "hooks.json",
    "CHANGELOG.md"
  ],
  "engines": {
    "bun": ">=1.3.13"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "bun test test/",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.5",
    "@deepseek-ai/dsh-skill": ">=0.1.0-rc.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "npm:@deepseek-ai/cordis@0.1.0-rc.5",
    "@deepseek-ai/dsh-skill": "npm:@deepseek-ai/dsh-skill@0.1.0-rc.5",
    "@types/node": ">=22.19.0",
    "typescript": ">=5.4.0"
  }
}
